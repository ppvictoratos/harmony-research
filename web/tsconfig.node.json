{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "playwright.config.ts"]
}
